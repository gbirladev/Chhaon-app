# Template for /etc/chhaon/backend.env on the EC2 box. Real values are written by the deploy
# pipeline from GitHub Secrets. Never commit real secrets.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
APP_JWT_SECRET=
ANTHROPIC_API_KEY=
# Self-hosted WhatsApp gateway: the HMAC secret of its webhook (same value as in the gateway dashboard).
# Blank = POST /webhooks/whatsapp-gateway refuses everything (503). Generate with: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# Supabase "Send SMS" auth hook secret (Dashboard -> Authentication -> Hooks). Lets login OTP codes go out over
# WhatsApp. Copy the secret Supabase shows (looks like "v1,whsec_..."). Blank = POST /hooks/supabase-sms refuses
# everything (503).
SUPABASE_SEND_SMS_HOOK_SECRET=

# Medicine photo in the WhatsApp reminder: read-only download from the PRIVATE Storage bucket "medicine-photos".
# SUPABASE_URL = https://<project-ref>.supabase.co (must be https). SUPABASE_SERVICE_ROLE_KEY = Supabase Dashboard ->
# Project Settings -> API keys -> service_role (or a secret "sb_secret_..." key). Server-only: never put it in the web app.
# Either blank = photos off, every reminder is plain text (nothing else changes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reminders (the scheduler). Leave false until the reply webhook is set up and tested; see docs/TODO.md, Switch-on checklist.
# A blank value in the deploy keeps what is on the box, so to turn it OFF again set it to false explicitly.
CHHAON_SCHEDULER_ENABLED=false
# ONE recipient id for the first switch-on; "all" = every family. A blank deploy value keeps what is on the box, so use "all" to widen.
CHHAON_SCHEDULER_ONLY_RECIPIENT=
# Dose reminders and the morning check-in as a WhatsApp POLL (one tap). Needs the gateway with poll votes (poll.vote webhook
# event, messageId in the poll response). Blank / false = typed replies ("1"). Falls back to text when a poll cannot be sent.
WHATSAPP_POLLS_ENABLED=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
