# Template for /opt/whatsapp-gateway/.env on the EC2 box. Never commit real values.
PORT=3000
# Supabase (Sydney) pooler with a dedicated schema for the gateway's tables + Baileys session.
DATABASE_URL=postgresql://postgres.utjgegiioflwnmesmgcv:<DB_PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?schema=wa_akg&connection_limit=10&pool_timeout=30&sslmode=require
AUTH_SECRET=<openssl rand -base64 32>
BASE_URL=https://wa.chhaon.site
AUTH_TRUST_HOST=true
# Baileys resilience (retry forever so OTP/reminders survive a reconnect).
WA_MAX_RECONNECT_ATTEMPTS=0
WA_RECONNECT_MAX_DELAY_MS=60000
BAILEYS_LOG_LEVEL=error
