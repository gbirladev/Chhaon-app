ENVIRONMENT=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=http://localhost:5173

# WhatsApp Business Cloud API (see docs/whatsapp-setup.md).
# Leave ACCESS_TOKEN / PHONE_NUMBER_ID empty to run in dry-run mode: nothing is sent, messages are only logged.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Later steps
ANTHROPIC_API_KEY=
CRON_SECRET=
