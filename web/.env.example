# From `npx supabase start` (local) or the Supabase dashboard (hosted, Mumbai region)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# FastAPI backend
VITE_API_URL=http://127.0.0.1:8000
# Report reading with AI (needs ANTHROPIC_API_KEY on the API). Off by default: the Reports tab shows "coming soon".
VITE_REPORTS_ENABLED=false
# Privacy pages, consent sheet, data export and account deletion (on)
VITE_PRIVACY_ENABLED=true
# Login by phone text message needs an SMS provider. Set to false to offer email only (production pilot).
VITE_PHONE_LOGIN=true
